# This file is a template only; the bot does not load .env automatically.
# Export these variables in the process environment or your supervisor.
# Never commit a real token.

BOT_TOKEN=
# Numeric Telegram user ID of the deployment owner (not @username).
OWNER_ID=123456789
# SQLite file on a persistent volume. Relative paths are resolved from the
# process working directory.
SUPPORT_DB_PATH=./support_bot.sqlite3
